      <Rectangle fx:id="rectangle1" arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="514.0" layoutX="245.0" layoutY="167.0" stroke="#e64a19" strokeType="INSIDE" strokeWidth="2.0" width="1080.0" />
      <Label fx:id="lblUserId" layoutX="350.0" layoutY="228.0" text="User ID">
