         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="btnCancelCategory" layoutX="833.0" layoutY="503.0" mnemonicParsing="false" onAction="#btnCancelCategoryOnAction" prefHeight="31.0" prefWidth="89.0" style="-fx-background-color: #E64A19;" text="Cancel" textFill="WHITE">
