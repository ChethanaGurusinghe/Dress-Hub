            <Font name="Castellar" size="30.0" />
         </font>
      </Label>
      <Label layoutX="704.0" layoutY="115.0" text="Add New Category" underline="true">
         <font>
            <Font name="System Bold" size="17.0" />
         </font>
      </Label>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="514.0" layoutX="235.0" layoutY="157.0" stroke="#e64a19" strokeType="INSIDE" strokeWidth="2.0" width="1080.0" />
      <Label layoutX="340.0" layoutY="218.0" text="Category ID">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtCategoryId" layoutX="456.0" layoutY="216.0" />
      <Label layoutX="740.0" layoutY="218.0" text="Category Name">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtCategoryName" layoutX="871.0" layoutY="216.0" prefHeight="26.0" prefWidth="256.0" />
      <Label layoutX="345.0" layoutY="286.0" text="Description">
         <font>
            <Font size="15.0" />
